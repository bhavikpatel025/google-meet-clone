  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Cloudinary": {
    "Url": "cloudinary://dummy-key:dummy-secret@dummy-cloud-name"
  },
  "AllowedHosts": "*"
